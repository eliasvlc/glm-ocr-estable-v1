#llama.cpp releases
#llama-b11476-bin-win-cpu-x64
https://github.com/ggml-org/llama.cpp/releases


#modelo
https://huggingface.co/ggml-org/GLM-OCR-GGUF/tree/main

#mmproject
https://huggingface.co/mradermacher/GLM-OCR-GGUF/tree/main



:VULKAN
echo.
echo Comprobando dispositivos disponibles...
.\llama-server.exe --list-devices
echo.
pause

echo Iniciando GLM-OCR con CPU + Vulkan...
start "" cmd /c "timeout /t 10 /nobreak >nul & start "" http://127.0.0.1:8080/"

.\llama-server.exe ^
  -m ".\models\Qwen2.5-VL-7B-Instruct-UD-Q4_K_XL.gguf" ^
  --mmproj ".\models\Qwen2.5-mmproj-F16.gguf" ^
  --host 127.0.0.1 ^
  --port 8080 ^
  --ctx-size 8192 ^
  --parallel 1 ^
  --threads 6 ^
  --n-gpu-layers all ^
  --temp 0.1 ^
  --flash-attn off ^
  -fit off

goto FIN

